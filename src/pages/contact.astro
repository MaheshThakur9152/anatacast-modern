---
import MainLayout from '../layouts/MainLayout.astro';
import ContactSection from '../components/contact/ContactSection.astro';
---

<MainLayout
  title="Contact — Ananta Cast"
  description="Request a quote from Ananta Cast. Send your drawing, material and annual quantity — we reply with feasibility and pricing."
  currentPath="/contact"
>
  <main>
    <!-- SECTION 1: CONTACT HERO -->
    <section class="relative h-[125svh]">
      <div class="sticky top-0 h-svh overflow-hidden">
        <div class="absolute inset-0 hero-clip-reveal">
          <div class="absolute inset-0 will-change-transform" style="transform:scale(1.05)">
            <img
              alt="Coordinate measuring machine inspecting a cast component"
              decoding="async"
              class="object-cover w-full h-full"
              src="/images/cmm.png"
            />
          </div>
        </div>
        <div class="absolute inset-0 bg-background" style="opacity:0.5"></div>
        <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-background to-transparent"></div>

        <div class="relative mx-auto flex h-full max-w-[1400px] flex-col justify-end px-5 pb-12 md:px-10 md:pb-16">
          <p class="mb-6 font-mono text-[0.7rem] tracking-[0.2em] text-foreground/70 uppercase md:text-xs">
            <span class="mr-2 inline-block size-1.5 translate-y-[-1px] rounded-full bg-molten align-middle"></span>
            Contact
          </p>
          <h1 class="text-[12.5vw] leading-[0.9] font-semibold tracking-[-0.045em] md:text-[8vw] xl:text-[7.5rem]">
            <span class="block overflow-hidden pb-[0.08em]"><span class="block animate-slide-up-1">Send a drawing.</span></span>
            <span class="block overflow-hidden pb-[0.08em]"><span class="block animate-slide-up-2"><span class="text-molten">Get a part.</span></span></span>
          </h1>
          <p class="mt-8 max-w-lg text-base leading-relaxed text-foreground/75 md:text-lg" data-text-reveal="words">
            Share your 2D/3D data, material and annual quantity. Our engineering team responds with feasibility and a clear quotation.
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION 2: CONTACT FORM -->
    <ContactSection
      tagNumber="07"
      tagLabel="Start a programme"
      title="Send us a drawing."
      subtitle="Share your part, material and volumes. Our engineering team reviews every enquiry for castability and responds with a feasibility note and quotation."
    />
  </main>
</MainLayout>
