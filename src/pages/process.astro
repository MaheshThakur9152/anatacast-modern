---
import MainLayout from '../layouts/MainLayout.astro';
import ProcessTimeline from '../components/process/ProcessTimeline.astro';

const steps = [
  {
    no: '01',
    title: 'Drawing review',
    body: 'Our engineers study your 2D/3D data for castability, gating and machining allowance.',
  },
  {
    no: '02',
    title: 'Feasibility & quote',
    body: 'You receive a feasibility note, suggested changes if any, and a clear quotation.',
  },
  {
    no: '03',
    title: 'Tooling',
    body: 'Wax injection dies are built and the first patterns are checked against your model.',
  },
  {
    no: '04',
    title: 'First article',
    body: 'Sample parts are cast, machined and fully inspected with a dimensional report for approval.',
  },
  {
    no: '05',
    title: 'Series production',
    body: 'Approved process is locked. Every lot ships with material certificates and inspection data.',
  },
];
---

<MainLayout
  title="Process — Ananta Cast"
  description="Tooling and wax, shell building, melting and pouring, fettling and heat treatment, CNC machining and inspection — the six stages of every Ananta Cast part."
  currentPath="/process"
>
  <main>
    <!-- SECTION 1: HERO -->
    <section class="relative h-[125svh]">
      <div class="sticky top-0 h-svh overflow-hidden">
        <div class="absolute inset-0 hero-clip-reveal">
          <div class="absolute inset-0 will-change-transform" style="transform:scale(1.05)">
            <img
              alt="Wax pattern tree assembled on a central sprue"
              decoding="async"
              class="object-cover w-full h-full"
              src="/images/wax-tree.png"
            />
          </div>
        </div>
        <div class="absolute inset-0 bg-background" style="opacity:0.5"></div>
        <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-background to-transparent"></div>

        <div class="relative mx-auto flex h-full max-w-[1400px] flex-col justify-end px-5 pb-12 md:px-10 md:pb-16">
          <p class="mb-6 font-mono text-[0.7rem] tracking-[0.2em] text-foreground/70 uppercase md:text-xs">
            <span class="mr-2 inline-block size-1.5 translate-y-[-1px] rounded-full bg-molten align-middle"></span>
            The process
          </p>
          <h1 class="text-[12.5vw] leading-[0.9] font-semibold tracking-[-0.045em] md:text-[8vw] xl:text-[7.5rem]">
            <span class="block overflow-hidden pb-[0.08em]"><span class="block animate-slide-up-1">From wax</span></span>
            <span class="block overflow-hidden pb-[0.08em]"><span class="block animate-slide-up-2"><span class="text-molten">to finished.</span></span></span>
          </h1>
          <p class="mt-8 max-w-lg text-base leading-relaxed text-foreground/75 md:text-lg" data-text-reveal="words">
            Lost-wax casting is a 5,000-year-old craft. We run it with modern tooling, controlled chemistry and in-house machining.
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION 2: SIX STAGES SCROLL TIMELINE -->
    <ProcessTimeline sectionId="process" />

    <!-- SECTION 3: WORKING WITH US (STEP TIMELINE) -->
    <section aria-label="Working with us" class="py-28 md:py-40">
      <div class="mx-auto grid max-w-[1400px] gap-14 px-5 md:grid-cols-[1fr_1.4fr] md:gap-20 md:px-10">
        <div class="md:sticky md:top-28 md:self-start">
          <div data-reveal style="opacity:0;transform:translateY(48px)">
            <p class="font-mono text-xs tracking-[0.2em] text-muted-foreground uppercase">
              <span class="text-molten">03</span> — Working with us
            </p>
            <h2 class="mt-4 text-4xl leading-[0.95] font-semibold tracking-[-0.04em] text-balance md:text-6xl">
              From enquiry to series production.
            </h2>
          </div>
        </div>

        <ol class="relative border-l border-border">
          {steps.map((s, idx) => (
            <li class="relative pb-14 pl-10 last:pb-0 md:pl-16">
              <span
                class="absolute top-2 left-0 size-3 -translate-x-[5px] rounded-full"
                style={idx === 0 ? 'background-color:var(--molten);' : 'background-color:var(--border);'}
              ></span>
              <div data-reveal style="opacity:0;transform:translateY(30px)">
                <p class="font-mono text-xs text-molten">{s.no}</p>
                <h3 class="mt-2 text-3xl font-semibold tracking-[-0.035em] md:text-5xl text-foreground">
                  {s.title}
                </h3>
                <p class="mt-3 max-w-lg text-base leading-relaxed text-foreground/65 md:text-lg" data-text-reveal="words">
                  {s.body}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- SECTION 4: START A PROJECT CTA -->
    <section aria-label="Start a project" class="px-3 py-20 md:px-6 md:py-28">
      <div class="relative mx-auto max-w-[1500px] overflow-hidden bg-molten px-6 py-20 text-background md:px-14 md:py-28 rounded-[36px] md:rounded-[48px]">
        <div class="flex flex-col gap-10 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="font-mono text-xs tracking-[0.2em] uppercase opacity-70">Start a programme</p>
            <h2 class="mt-4 max-w-3xl text-5xl leading-[0.92] font-semibold tracking-[-0.045em] text-balance md:text-8xl">
              Send us a drawing.
            </h2>
          </div>
          <a class="group inline-flex h-14 shrink-0 items-center justify-center gap-3 self-start rounded-full bg-background px-8 text-base font-medium text-foreground transition-transform hover:scale-[1.03] md:self-auto" href="/contact">
            Request a quote
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right size-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true">
              <path d="M7 7h10v10"></path>
              <path d="M7 17 17 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>
</MainLayout>
