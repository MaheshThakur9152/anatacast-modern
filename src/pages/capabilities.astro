---
import MainLayout from '../layouts/MainLayout.astro';
import AlloyMarquee from '../components/shared/AlloyMarquee.astro';

const envelopeSpecs = [
  { dt: 'Process', dd: 'Lost-wax investment casting' },
  { dt: 'Part weight', dd: '0.02 – 40 kg' },
  { dt: 'Dimensional tolerance', dd: 'ISO 8062 · CT4 – CT6' },
  { dt: 'As-cast surface', dd: 'Ra 3.2 – 6.3 µm' },
  { dt: 'Machining', dd: 'CNC turning · VMC · 4/5-axis milling' },
  { dt: 'Heat treatment', dd: 'Annealing · Normalising · Q&T · Case hardening' },
  { dt: 'Testing', dd: 'Spectro · CMM · Hardness · DP · Radiography' },
];

const disciplines = [
  {
    no: '01',
    title: 'Investment casting',
    body: 'Lost-wax casting in ferrous alloys for complex, near-net shapes with fine detail and excellent as-cast finish.',
    points: ['In-house wax tooling', 'Ceramic shell building', 'Induction melting', 'Spectro-verified chemistry'],
    img: '/images/hero-pour.png',
  },
  {
    no: '02',
    title: 'CNC machining',
    body: 'Castings move straight to our machine shop for critical faces, bores and threads — finished to drawing tolerance.',
    points: ['CNC turning', 'Vertical machining centres', '4/5-axis milling', 'Drilling & tapping'],
    img: '/images/cnc.png',
  },
  {
    no: '03',
    title: 'Heat treatment',
    body: 'Controlled thermal cycles deliver the hardness, strength and corrosion resistance your application demands.',
    points: ['Solution annealing', 'Normalising', 'Hardening & tempering', 'Case hardening'],
    img: '/images/impeller.png',
  },
  {
    no: '04',
    title: 'Testing & quality',
    body: 'Every lot is measured and documented. Reports travel with the parts, so your incoming inspection is simple.',
    points: ['CMM inspection', 'Hardness & tensile', 'Dye penetrant', 'Radiography · MTC'],
    img: '/images/cmm.png',
  },
];

const materials = [
  {
    title: 'Austenitic stainless',
    alloys: 'SS 304 · SS 316 · CF8 · CF8M · CF3M',
    use: 'Corrosion resistance, hygienic service',
  },
  {
    title: 'Martensitic & PH',
    alloys: 'SS 410 · SS 420 · CA15 · 17-4 PH',
    use: 'Strength, hardness, wear',
  },
  {
    title: 'Duplex stainless',
    alloys: 'Duplex 2205 · Super Duplex',
    use: 'Chlorides, high pressure',
  },
  {
    title: 'Carbon steels',
    alloys: 'WCB · LCB · EN 8',
    use: 'Pressure parts, general use',
  },
  {
    title: 'Low-alloy steels',
    alloys: 'AISI 4140 · 8620 · EN 19',
    use: 'Toughness, case-hardened parts',
  },
  {
    title: 'Tool steels',
    alloys: 'On request',
    use: 'Dies, wear components',
  },
];
---

<MainLayout
  title="Capabilities — Ananta Cast"
  description="Investment casting, CNC machining, heat treatment and testing — ferrous castings from 0.02 to 40 kg in stainless, duplex, carbon and alloy steels."
  currentPath="/capabilities"
>
  <main>
    <!-- SECTION 1: HERO -->
    <section class="relative h-[125svh]">
      <div class="sticky top-0 h-svh overflow-hidden">
        <div class="absolute inset-0 hero-clip-reveal">
          <div class="absolute inset-0 will-change-transform" style="transform:scale(1.05)">
            <img
              alt="CNC machine cutting an investment cast component"
              decoding="async"
              class="object-cover w-full h-full"
              src="/images/cnc.png"
            />
          </div>
        </div>
        <div class="absolute inset-0 bg-background" style="opacity:0.5"></div>
        <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-background to-transparent"></div>

        <div class="relative mx-auto flex h-full max-w-[1400px] flex-col justify-end px-5 pb-12 md:px-10 md:pb-16">
          <p class="mb-6 font-mono text-[0.7rem] tracking-[0.2em] text-foreground/70 uppercase md:text-xs">
            <span class="mr-2 inline-block size-1.5 translate-y-[-1px] rounded-full bg-molten align-middle"></span>
            Capabilities
          </p>
          <h1 class="text-[12.5vw] leading-[0.9] font-semibold tracking-[-0.045em] md:text-[8vw] xl:text-[7.5rem]">
            <span class="block overflow-hidden pb-[0.08em]"><span class="block animate-slide-up-1">Four disciplines.</span></span>
            <span class="block overflow-hidden pb-[0.08em]"><span class="block animate-slide-up-2"><span class="text-molten">One floor.</span></span></span>
          </h1>
          <p class="mt-8 max-w-lg text-base leading-relaxed text-foreground/75 md:text-lg" data-text-reveal="words">
            Casting, machining, heat treatment and inspection run side by side — so your part never waits for a second supplier.
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION 2: TECHNICAL ENVELOPE -->
    <section aria-label="Technical envelope" class="py-24 md:py-36">
      <div class="mx-auto grid max-w-[1400px] gap-12 px-5 md:grid-cols-[1fr_1.3fr] md:gap-20 md:px-10">
        <div data-reveal style="opacity:0;transform:translateY(48px)">
          <p class="font-mono text-xs tracking-[0.2em] text-muted-foreground uppercase">
            <span class="text-molten">01</span> — Technical envelope
          </p>
          <h2 class="mt-4 text-4xl leading-[0.95] font-semibold tracking-[-0.04em] text-balance md:text-6xl">
            What we can hold.
          </h2>
          <p class="mt-6 max-w-sm text-base leading-relaxed text-foreground/65" data-text-reveal="words">
            Typical ranges. Tighter requirements are reviewed case by case during feasibility.
          </p>
        </div>

        <dl class="divide-y divide-border border-y border-border">
          {envelopeSpecs.map((spec) => (
            <div data-reveal style="opacity:0;transform:translateY(24px)">
              <div class="grid grid-cols-1 gap-1 py-5 sm:grid-cols-[12rem_1fr] sm:gap-6">
                <dt class="font-mono text-xs tracking-wider text-muted-foreground uppercase">{spec.dt}</dt>
                <dd class="text-lg font-medium tracking-tight md:text-xl">{spec.dd}</dd>
              </div>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- SECTION 3: CORE CAPABILITIES (STACKED CARDS) -->
    <section aria-label="Core capabilities" class="relative py-16 md:py-24">
      <div class="mx-auto max-w-[1400px] px-5 md:px-10 flex flex-col gap-10">
        <p class="font-mono text-xs tracking-[0.2em] text-muted-foreground uppercase">
          <span class="text-molten">02</span> — Core disciplines
        </p>
        {disciplines.map((d) => (
          <article class="relative flex flex-col overflow-hidden rounded-lg border border-border bg-card md:flex-row md:items-stretch">
            <div class="relative h-64 md:h-auto md:w-1/2 overflow-hidden bg-black">
              <img
                alt={d.title}
                loading="lazy"
                decoding="async"
                class="object-cover w-full h-full"
                src={d.img}
              />
            </div>
            <div class="flex flex-1 flex-col justify-between gap-6 p-6 md:p-12">
              <div>
                <p class="font-mono text-sm text-molten">{d.no}</p>
                <h3 class="mt-3 text-4xl leading-none font-semibold tracking-[-0.04em] md:text-6xl">
                  {d.title}
                </h3>
                <p class="mt-4 max-w-md text-base leading-relaxed text-foreground/75 md:text-lg" data-text-reveal="words">
                  {d.body}
                </p>
              </div>
              <ul class="grid grid-cols-2 gap-3 pt-4 border-t border-border">
                {d.points.map((pt) => (
                  <li class="flex items-center gap-2 text-sm text-foreground/70">
                    <span class="size-1 rounded-full bg-molten"></span>
                    {pt}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- SECTION 4: MATERIALS -->
    <section aria-label="Material families" class="py-28 md:py-40">
      <div class="mx-auto max-w-[1400px] px-5 md:px-10">
        <div data-reveal style="opacity:0;transform:translateY(48px)">
          <p class="font-mono text-xs tracking-[0.2em] text-muted-foreground uppercase">
            <span class="text-molten">03</span> — Materials
          </p>
          <h2 class="mt-4 max-w-2xl text-4xl leading-[0.95] font-semibold tracking-[-0.04em] text-balance md:text-6xl">
            The right alloy for the job.
          </h2>
        </div>

        <ul class="mt-14 border-t border-border">
          {materials.map((m) => (
            <li class="group relative border-b border-border">
              <span class="absolute inset-0 origin-bottom scale-y-0 bg-card transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-y-100"></span>
              <div class="relative grid gap-2 py-6 md:grid-cols-[1.1fr_1.4fr_1fr] md:items-baseline md:gap-8 md:px-4 md:py-8">
                <h3 class="text-2xl font-semibold tracking-[-0.03em] md:text-3xl text-foreground">
                  {m.title}
                </h3>
                <p class="font-mono text-sm tracking-wide text-steel">
                  {m.alloys}
                </p>
                <p class="text-sm text-foreground/60 md:text-right" data-text-reveal="words">
                  {m.use}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ALLOY TICKER MARQUEE -->
    <AlloyMarquee />

    <!-- SECTION 5: START A PROGRAMME CTA -->
    <section aria-label="Start a project" class="px-3 py-20 md:px-6 md:py-28">
      <div class="relative mx-auto max-w-[1500px] overflow-hidden bg-molten px-6 py-20 text-background md:px-14 md:py-28 rounded-[36px] md:rounded-[48px]">
        <div class="flex flex-col gap-10 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="font-mono text-xs tracking-[0.2em] uppercase opacity-70">Start a programme</p>
            <h2 class="mt-4 max-w-3xl text-5xl leading-[0.92] font-semibold tracking-[-0.045em] text-balance md:text-8xl">
              Send us a drawing.
            </h2>
          </div>
          <a class="group inline-flex h-14 shrink-0 items-center justify-center gap-3 self-start rounded-full bg-background px-8 text-base font-medium text-foreground transition-transform hover:scale-[1.03] md:self-auto" href="/contact">
            Request a quote
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right size-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true">
              <path d="M7 7h10v10"></path>
              <path d="M7 17 17 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>
</MainLayout>
