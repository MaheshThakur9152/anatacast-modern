---
const categories = ['All', 'Flow control', 'Rotating', 'Structural', 'Machined'];

const products = [
  {
    title: 'Valve bodies',
    cat: 'Flow control',
    mat: 'CF8M · WCB · Duplex 2205',
    wt: '0.5 – 40 kg',
    img: '/images/finished-part.png',
    alt: 'Valve bodies',
  },
  {
    title: 'Pump impellers',
    cat: 'Rotating',
    mat: 'CF8 · CA15 · 17-4 PH',
    wt: '0.2 – 25 kg',
    img: '/images/impeller.png',
    alt: 'Pump impellers',
  },
  {
    title: 'Levers & brackets',
    cat: 'Structural',
    mat: 'AISI 4140 · 8620 · SS 410',
    wt: '0.05 – 5 kg',
    img: '/images/bracket.png',
    alt: 'Levers & brackets',
  },
  {
    title: 'Hygienic fittings',
    cat: 'Flow control',
    mat: 'CF3M · SS 316L',
    wt: '0.1 – 8 kg',
    img: '/images/cnc.png',
    alt: 'Hygienic fittings',
  },
  {
    title: 'Turbo & hot-section parts',
    cat: 'Rotating',
    mat: 'SS 410 · Heat-resistant grades',
    wt: '0.1 – 6 kg',
    img: '/images/cmm.png',
    alt: 'Turbo & hot-section parts',
  },
  {
    title: 'Forks & linkages',
    cat: 'Structural',
    mat: 'EN 19 · EN 8 · AISI 4140',
    wt: '0.1 – 10 kg',
    img: '/images/bracket.png',
    alt: 'Forks & linkages',
  },
  {
    title: 'Machined assemblies',
    cat: 'Machined',
    mat: 'Cast + CNC finished',
    wt: 'To drawing',
    img: '/images/cnc.png',
    alt: 'Machined assemblies',
  },
  {
    title: 'Pump casings',
    cat: 'Flow control',
    mat: 'CF8M · CF3M · Super Duplex',
    wt: '1 – 40 kg',
    img: '/images/finished-part.png',
    alt: 'Pump casings',
  },
  {
    title: 'Prototype castings',
    cat: 'Machined',
    mat: 'Any listed grade',
    wt: 'Low volume',
    img: '/images/wax-tree.png',
    alt: 'Prototype castings',
  },
];
---

<section aria-label="Product catalogue" class="py-20 md:py-32">
  <div class="mx-auto max-w-[1400px] px-5 md:px-10">
    <!-- Filter tabs -->
    <div class="-mx-5 overflow-x-auto px-5 [scrollbar-width:none] md:mx-0 md:px-0">
      <div role="group" aria-label="Filter by category" class="flex w-max gap-2" id="filter-buttons">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-category={cat}
            aria-pressed={idx === 0 ? 'true' : 'false'}
            class={idx === 0
              ? 'filter-btn relative h-11 rounded-full border px-5 text-sm transition-colors border-transparent text-background'
              : 'filter-btn relative h-11 rounded-full border px-5 text-sm transition-colors border-border text-foreground/70 hover:text-foreground'}
          >
            {idx === 0 && <span class="active-pill absolute inset-0 rounded-full bg-foreground"></span>}
            <span class="relative z-10">{cat}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Live result count -->
    <p id="product-counter" class="mt-6 font-mono text-xs tracking-wider text-muted-foreground uppercase" aria-live="polite">
      09 part families
    </p>

    <!-- Product Grid -->
    <div id="product-grid" class="mt-8 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {products.map((p) => (
        <article
          class="product-card group transition-all duration-500"
          data-category={p.cat}
        >
          <div class="relative aspect-[4/5] overflow-hidden rounded-md bg-card">
            <div class="absolute -inset-y-[10%] inset-x-0" style="transform:translateY(-10%)">
              <img
                alt={p.alt}
                loading="lazy"
                decoding="async"
                class="object-cover w-full h-full transition-transform duration-[1.2s] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105"
                src={p.img}
              />
            </div>
            <span class="absolute top-4 left-4 rounded-full bg-background/70 px-3 py-1 font-mono text-[0.65rem] tracking-wider uppercase backdrop-blur-md">
              {p.cat}
            </span>
          </div>
          <div class="mt-4 flex items-start justify-between gap-4">
            <div>
              <h3 class="text-xl font-semibold tracking-tight md:text-2xl">
                {p.title}
              </h3>
              <p class="mt-1 font-mono text-xs tracking-wider text-steel uppercase">
                {p.mat}
              </p>
            </div>
            <p class="shrink-0 font-mono text-xs text-foreground/55">
              {p.wt}
            </p>
          </div>
        </article>
      ))}
    </div>
    <p class="mt-16 max-w-xl text-sm leading-relaxed text-foreground/55" data-text-reveal="words">
      Representative part families shown. Every component is cast and machined to the customer's own drawing and specification.
    </p>
  </div>
</section>

<script>
  function setupProductFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.product-card');
    const counter = document.getElementById('product-counter');

    if (!buttons.length || !cards.length || !counter) return;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category');
        if (!cat) return;

        // Update button states
        buttons.forEach((b) => {
          b.setAttribute('aria-pressed', 'false');
          b.className = 'filter-btn relative h-11 rounded-full border px-5 text-sm transition-colors border-border text-foreground/70 hover:text-foreground';
          const pill = b.querySelector('.active-pill');
          if (pill) pill.remove();
        });

        btn.setAttribute('aria-pressed', 'true');
        btn.className = 'filter-btn relative h-11 rounded-full border px-5 text-sm transition-colors border-transparent text-background';
        const pill = document.createElement('span');
        pill.className = 'active-pill absolute inset-0 rounded-full bg-foreground';
        btn.prepend(pill);

        // Filter cards
        let visibleCount = 0;
        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-category');
          if (cat === 'All' || cardCat === cat) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        // Update counter with zero padding
        const pad = visibleCount < 10 ? `0${visibleCount}` : `${visibleCount}`;
        counter.textContent = `${pad} part families`;
      });
    });
  }

  setupProductFilters();
  document.addEventListener('astro:page-load', setupProductFilters);
</script>
